<Window x:Class="ComfyTunnel.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:ComfyTunnel.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="ComfyTunnel" Width="560" Height="720" MinWidth="500" MinHeight="640" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen" Closing="OnClosing">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#9999A3"/><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="ConnectAction" TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#DA526B" Offset="0"/><GradientStop Color="#C4455C" Offset="1"/></LinearGradientBrush></Setter.Value></Setter><Setter Property="BorderBrush" Value="{StaticResource AccentSoft}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" CornerRadius="6" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Padding="0"><Grid><Border BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0" CornerRadius="6" IsHitTestVisible="False"/><StackPanel Margin="24,14"><ContentPresenter HorizontalAlignment="Center"/><ProgressBar x:Name="Activity" Height="2" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource Ink}" Background="#55FFFFFF"/></StackPanel></Grid></Border><ControlTemplate.Triggers><Trigger Property="Tag" Value="Busy"><Setter TargetName="Activity" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="Tag" Value="Waiting"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Warning}"/></Trigger><Trigger Property="Tag" Value="Connected"><Setter TargetName="Frame" Property="Background" Value="Transparent"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Ink}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  <Style x:Key="RemoveButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Error}"/></Trigger></Style.Triggers></Style>

  <Style x:Key="FeatureSwitch" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border Background="Transparent" Padding="4" Width="52" Height="36"><Border x:Name="Track" Background="#333338" BorderBrush="#52525B" BorderThickness="1" CornerRadius="5"><Border x:Name="Thumb" Width="16" Height="16" CornerRadius="3" HorizontalAlignment="Left" Margin="3,0,0,0" Background="#A9A9B1" VerticalAlignment="Center"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border></Border></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#9F3E50"/><Setter TargetName="Track" Property="BorderBrush" Value="#CC5D72"/><Setter TargetName="Thumb" Property="Background" Value="#FAF6F7"/><Setter TargetName="Thumb" Property="RenderTransform"><Setter.Value><TranslateTransform X="18"/></Setter.Value></Setter></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#E0A2AF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border BorderBrush="#343438" BorderThickness="1" Background="{StaticResource Canvas}" CornerRadius="12"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="18,0,6,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="—" Width="40" Height="40" ToolTip="最小化" Click="MinimizeWindow" Style="{StaticResource QuietButton}"/><Button Content="×" Width="40" Height="40" ToolTip="关闭到托盘" Click="HideWindow" Style="{StaticResource CloseButton}" FontSize="19"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{StaticResource Accent}" Width="6" Height="13" CornerRadius="2" Margin="0,0,9,0"/><TextBlock Text="COMFYTUNNEL" Foreground="#B7B7BE" FontSize="10" FontWeight="SemiBold"/></StackPanel></DockPanel>
  <Grid Grid.Row="1">
   <Grid x:Name="HomePage" Margin="36,20,36,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="你的远程工作空间" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="选好服务器，其余交给隧道。" Foreground="{StaticResource Subtle}" FontSize="12"/></StackPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,24">
     <Button x:Name="ServerCard" AutomationProperties.Name="选择服务器" Click="OpenServers" Padding="0" Background="{StaticResource Surface}" HorizontalContentAlignment="Stretch" MinHeight="88"><Button.Template><ControlTemplate TargetType="Button"><Grid><Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8"/><Border x:Name="Highlight" BorderBrush="#16FFFFFF" BorderThickness="0,1,0,0" CornerRadius="8"/><Rectangle x:Name="Dashed" Stroke="#65656E" StrokeThickness="1" StrokeDashArray="3,3" RadiusX="8" RadiusY="8" Visibility="Collapsed"/><ContentPresenter Margin="20"/></Grid><ControlTemplate.Triggers><Trigger Property="Tag" Value="Empty"><Setter TargetName="Dashed" Property="Visibility" Value="Visible"/><Setter TargetName="Card" Property="BorderThickness" Value="0"/><Setter TargetName="Card" Property="Background" Value="Transparent"/><Setter TargetName="Highlight" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#242427"/><Setter TargetName="Dashed" Property="Stroke" Value="#BD7D8B"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Dashed" Property="Stroke" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
      <Grid><StackPanel x:Name="EmptyServerPrompt" HorizontalAlignment="Center" Margin="0,14"><TextBlock Text="＋" Foreground="{StaticResource Accent}" FontSize="28" HorizontalAlignment="Center"/><TextBlock Text="添加你的第一台服务器" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="填写 SSH 信息，即可开始" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel>
       <Grid x:Name="ServerIdentity"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions><Border Width="28" Height="30" CornerRadius="6" Background="#303034" VerticalAlignment="Center"><Path Data="M 6 5 H 22 V 25 H 6 Z M 6 15 H 22 M 9 10 H 11 M 9 20 H 11" Stroke="{StaticResource Muted}" StrokeThickness="2"/></Border><StackPanel Grid.Column="1" Margin="12,0"><TextBlock x:Name="ConnectionTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ServerSummary" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock x:Name="ServerChevron" Grid.Column="2" Text="⌄" Foreground="{StaticResource Muted}" FontSize="18" VerticalAlignment="Center"/></Grid>
      </Grid>
     </Button>
     <Button x:Name="EditButton" Content="编辑连接" Click="OpenEditor" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,8,0,8"/>
     <StackPanel x:Name="ConnectionActions">
      <Border Background="{StaticResource Surface}" CornerRadius="8" BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="0,8,0,24"><Grid><Border BorderBrush="#16FFFFFF" BorderThickness="0,1,0,0" CornerRadius="8"/><Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="ComfyUI 端口转发" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="ModeHint" Text="仅 SSH · 不开放本地端口" FontFamily="Consolas, Microsoft YaHei UI" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><CheckBox Grid.Column="1" x:Name="EnableComfyBox" AutomationProperties.Name="启用 ComfyUI 转发" Style="{StaticResource FeatureSwitch}" IsChecked="False" Checked="ComfyModeChanged" Unchecked="ComfyModeChanged" VerticalAlignment="Center" ToolTip="连接后不可切换，请先断开。"/></Grid></Grid></Border>
      <Button x:Name="ConnectButton" Content="连接" Click="ToggleConnection" Style="{StaticResource ConnectAction}" MinHeight="48" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Stretch"/>
      <TextBlock x:Name="StateLabel" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"/><TextBlock x:Name="DetailLabel" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" MaxHeight="65"/>
     </StackPanel>
    </StackPanel>
    <StackPanel Grid.Row="2"><Border x:Name="AddressPanel" Visibility="Collapsed" CornerRadius="8" Background="{StaticResource Surface}" Padding="12" Margin="0,0,0,16"><StackPanel><TextBox x:Name="UrlBox" FontFamily="Consolas" IsReadOnly="True" Background="Transparent" BorderThickness="0" TextAlignment="Center" FontSize="14"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0"><Button x:Name="CopyButton" Content="复制地址" Click="CopyAddress" IsEnabled="False" Style="{StaticResource QuietButton}"/><Button x:Name="OpenButton" Content="打开 ComfyUI ↗" Click="OpenAddress" IsEnabled="False" Style="{StaticResource QuietButton}"/></StackPanel></StackPanel></Border><DockPanel><Button DockPanel.Dock="Right" Content="连接记录" Click="OpenLogs" Style="{StaticResource QuietButton}"/><TextBlock Text="本地加密保存" Foreground="{StaticResource Subtle}" FontSize="10" VerticalAlignment="Center"/></DockPanel></StackPanel>
   </Grid>
   <Grid x:Name="ServersPage" Visibility="Collapsed" Margin="28,16,28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,22"><Button HorizontalAlignment="Left" Content="‹  返回" Click="GoHome" Style="{StaticResource QuietButton}"/><TextBlock Text="选择服务器" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><Grid x:Name="ProfileNavigation" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="CountLabel" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,15"/><ListBox Grid.Row="1" x:Name="ProfileList" SelectionChanged="SelectConnection" MouseDoubleClick="UseSelectedServer"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Profile.Host}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Content="＋  添加服务器" Click="NewConnection" Margin="0,18,0,0"/></Grid></Grid>
   <Grid x:Name="EditorPage" Visibility="Collapsed" Margin="24,12,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,14"><Button HorizontalAlignment="Left" Content="‹  返回" Click="CloseEditor" Style="{StaticResource QuietButton}"/><TextBlock Text="连接设置" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Editor" Margin="0,0,8,0">
     <Border Background="Transparent" BorderThickness="0" Padding="4,8"><StackPanel>
      
      <TextBlock Text="连接名称" Style="{StaticResource Label}"/><TextBox x:Name="NameBox" AutomationProperties.Name="连接名称" ui:Field.Placeholder="例如：训练机" MaxLength="80" Margin="0,0,0,14"/>
      <TextBlock Text="主机信息" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" Margin="4,8,0,12"/><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="服务器地址" Style="{StaticResource Label}"/><TextBox x:Name="HostBox" AutomationProperties.Name="服务器地址" FontFamily="Consolas" ui:Field.Placeholder="example.com 或 192.168.1.10"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="SSH 端口" Style="{StaticResource Label}"/><TextBox x:Name="SshPortBox" AutomationProperties.Name="SSH 端口" FontFamily="Consolas" ui:Field.Placeholder="22" Text="22"/></StackPanel></Grid>
      <TextBlock Text="用户名" Style="{StaticResource Label}"/><TextBox x:Name="UserBox" AutomationProperties.Name="用户名" ui:Field.Placeholder="例如：ubuntu" Margin="0,0,0,16"/><TextBlock Text="认证方式" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" Margin="4,12,0,12"/><Border Background="{StaticResource Input}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="12" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,16"><StackPanel Orientation="Horizontal"><RadioButton x:Name="PasswordMode" Content="密码" IsChecked="True" GroupName="Auth" Checked="AuthChanged"/><RadioButton x:Name="KeyMode" Content="私钥" GroupName="Auth" Checked="AuthChanged"/></StackPanel></Border>
      <DockPanel x:Name="KeyRow" Visibility="Collapsed" Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="选择私钥" Click="BrowseKey" Margin="8,0,0,0"/><TextBox x:Name="KeyBox" AutomationProperties.Name="私钥路径" ui:Field.Placeholder="选择本机私钥文件"/></DockPanel>
      <TextBlock x:Name="SecretLabel" Text="SSH 密码" Style="{StaticResource Label}"/><PasswordBox x:Name="SecretBox" AutomationProperties.Name="密码或私钥口令" ui:Field.Placeholder="输入 SSH 密码"/><CheckBox x:Name="RememberBox" Content="记住密码 / 私钥口令" FontSize="12"/><TextBlock Text="仅在本机账户下加密保存" Foreground="{StaticResource Subtle}" FontSize="11" Margin="24,4,0,0"/>
      <Border Height="1" Background="#35353A" Margin="0,16,0,0"/><Expander Header="从 SSH 命令导入" x:Name="ImportPanel"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="导入" Click="ParseCommand" Margin="8,0,0,0"/><TextBox x:Name="CommandBox" AutomationProperties.Name="SSH 命令" FontFamily="Consolas" ui:Field.Placeholder="ssh -p 2222 ubuntu@example.com" TextChanged="CommandChanged" ToolTip="ssh -p 12345 ubuntu@gpu.example.com"/></DockPanel><TextBlock x:Name="ParseHint" Text="粘贴 SSH 命令自动填写；不会执行命令。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/></StackPanel></Expander>
     </StackPanel></Border>
     <Border Background="{StaticResource Surface}" BorderBrush="#333338" BorderThickness="1" CornerRadius="8" Padding="20,5" Margin="0,12,0,0"><Expander Header="ComfyUI 连接设置" x:Name="ComfyPanel"><StackPanel><CheckBox Content="启用 ComfyUI 转发" IsChecked="{Binding IsChecked, ElementName=EnableComfyBox, Mode=TwoWay}" Margin="0,0,0,12"/><StackPanel x:Name="ComfyFields">
      <TextBlock Text="勾选后才创建本地转发；收起不改变开关。" Style="{StaticResource Label}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="目标地址" Style="{StaticResource Label}"/><TextBox x:Name="TargetHostBox" TextChanged="ForwardingFieldChanged" AutomationProperties.Name="目标地址" FontFamily="Consolas" ui:Field.Placeholder="127.0.0.1" Text="127.0.0.1"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ComfyUI 端口" Style="{StaticResource Label}"/><TextBox x:Name="TargetPortBox" TextChanged="ForwardingFieldChanged" AutomationProperties.Name="ComfyUI 端口" FontFamily="Consolas" ui:Field.Placeholder="8188" Text="8188"/></StackPanel></Grid>
      <Grid Margin="0,14,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本地端口" Style="{StaticResource Label}"/><TextBox x:Name="LocalPortBox" TextChanged="ForwardingFieldChanged" AutomationProperties.Name="本地端口" FontFamily="Consolas" ui:Field.Placeholder="18188" Text="18188"/></StackPanel><CheckBox Grid.Column="1" x:Name="AutoPortBox" Content="端口占用时自动选择" IsChecked="True" Margin="16,25,0,0" VerticalAlignment="Center"/></Grid>
      <TextBlock Text="远端 ComfyUI 需已启动。目标地址从 SSH 服务器访问。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,12" TextWrapping="Wrap"/>
     </StackPanel></StackPanel></Expander></Border>
    </StackPanel></ScrollViewer><DockPanel Grid.Row="2" Margin="0,15,0,0"><Button x:Name="SaveButton" DockPanel.Dock="Right" Content="保存并返回" Click="SaveProfile" ToolTip="保存并返回（Ctrl+S）" Height="44" Style="{StaticResource Primary}" Padding="24,10"/><Button Content="移除连接" Click="DeleteConnection" Margin="0,0,24,0" Style="{StaticResource RemoveButton}" HorizontalAlignment="Left"/></DockPanel></Grid>
   <Grid x:Name="LogsPage" Visibility="Collapsed" Margin="28,16,28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,22"><Button HorizontalAlignment="Left" Content="‹  返回" Click="GoHome" Style="{StaticResource QuietButton}"/><TextBlock Text="连接记录" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12"/><Button Grid.Row="2" Content="第三方许可" Click="ShowLicenses" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/></Grid>
  </Grid>
 </Grid></Border>
</Window>